 namespace wsdr {
 
+// fpvDROID: whether the link is SuperSpeed. libusb asks the kernel, and for a device opened from an fd (Android) it
+// can only do so with USBDEVFS_GET_SPEED, which older kernels lack (an LG G7 on Android 10, kernel 4.9): the speed
+// comes back unknown. Taken as USB 2, a SuperSpeed link then got 4096-byte EP0 block writes (the USB 2 size in
+// Reg), which the chip stalls: LIBUSB_ERROR_PIPE at the streamer's first block, every start. The descriptors say it
+// then: a bulk endpoint's packets are 1024 bytes only at SuperSpeed (512 at high speed), and a USB 3 device reports
+// bcdUSB 0x0300 or above only while it runs at SuperSpeed (0x0210 at high speed).
+static bool superspeed_link(libusb_device_handle *h) {
+  libusb_device *d = libusb_get_device(h);
+  const int sp = libusb_get_device_speed(d);
+  if (sp != LIBUSB_SPEED_UNKNOWN)
+    return sp >= LIBUSB_SPEED_SUPER;
+  const int mps = libusb_get_max_packet_size(d, 0x84); // the bulk-IN the streams read
+  libusb_device_descriptor dd{};
+  const bool ss = mps > 0 ? mps >= 1024 : libusb_get_device_descriptor(d, &dd) == 0 && dd.bcdUSB >= 0x0300;
+  std::fprintf(stderr, "usb: the kernel does not give the link speed; USB %d from the descriptors (bulk-IN packets %d)\n",
+               ss ? 3 : 2, mps);
+  return ss;
+}
 
+// fpvDROID: the USB 3 PHY value Realtek's drivers write at bring-up and devourer does not. halmac
+// (usb3_phy_param_8822b, applied by phy_cfg_usb_8822b) and Linux's rtw88 (usb3_param_8822b, rtw_usb_phy_cfg) both
+// set the 8822B's USB 3 PHY register 0x01 to 0xA841, on cut D only, through 0xFF0D/0xFF0E (data) and 0xFF0C
+// (address; BIT(7) writes, BIT(6) reads with the value then in 0xFF0C's bytes 1-2: halmac's usbphy_*_88xx).
+// Realtek does not say what it tunes. On trial against the C2H wedge (FINDINGS §4) on phones, whose 5 Gbps links
+// are more marginal than a PC's: WSDR_USB3_PHY=1 writes it (cut D only), =0 only reads and logs it, and unset
+// leaves the link alone.
+static void usb3_phy_param(Reg &reg, const std::string &chip, bool ss) {
+  const char *e = std::getenv("WSDR_USB3_PHY");
+  if (!e || !*e || chip != "RTL8822B" || !ss)
+    return;
+  try {
+    auto read = [&reg](uint8_t a) {
+      reg.w8(0xFF0C, static_cast<uint8_t>(a | 0x40));
+      return static_cast<unsigned>((reg.r32(0xFF0C) >> 8) & 0xFFFF);
+    };
+    const unsigned cut = (reg.r32(0x00F0) >> 12) & 0xF;
+    const unsigned before = read(0x01);
+    if (std::atoi(e) != 1 || cut != 3) {
+      std::fprintf(stderr, "usb3 phy: cut %u, reg 0x01 = 0x%04x, left alone\n", cut, before);
+      return;
+    }
+    reg.w8(0xFF0D, 0x41);
+    reg.w8(0xFF0E, 0xA8);
+    reg.w8(0xFF0C, 0x01 | 0x80);
+    std::fprintf(stderr, "usb3 phy: cut %u, reg 0x01 was 0x%04x, wrote 0xa841, reads 0x%04x\n", cut, before,
+                 read(0x01));
+  } catch (const std::exception &x) {
+    std::fprintf(stderr, "usb3 phy: failed: %s\n", x.what());
+  }
+}
 
